@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="hero-section">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <p class="hero-eyebrow">
            Timeless Beauty • Modern Luxury
        </p>

        <h1>
            Jewellery Made<br />
            To Be Remembered
        </h1>

        <p class="hero-description">
            Discover handmade silver, gold-plated and rose-gold-plated
            jewellery created for every layer of you.
        </p>

        <div class="hero-buttons">

            <a href="#new-arrivals"
               class="luxury-button luxury-button-gold">

                Shop New Arrivals

            </a>

            <a href="#collections"
               class="luxury-button luxury-button-outline">

                Explore Collections

            </a>

        </div>

    </div>

</section>


<!-- INTRODUCTION -->
<section class="intro-section section-padding reveal">

    <div class="luxury-container intro-content">

        <p class="section-eyebrow">
            Luxe Layers LK
        </p>

        <h2>
            Jewellery for every layer of you
        </h2>

        <p>
            Every Luxe Layers LK piece is handmade with care.
            Explore jewellery created for women and men,
            from timeless silver to luxurious gold-plated
            and rose-gold-plated finishes.
        </p>

    </div>

</section>

<!-- PRECIOUS STONE JEWELLERY -->
<section class="stone-section section-padding"
         id="precious-stones">

    <div class="luxury-container">

        <div class="center-heading reveal">

            <p class="section-eyebrow">
                Rare Beauty • Timeless Elegance
            </p>

            <h2>
                Precious Stone Jewellery
            </h2>

            <p>
                Discover handcrafted jewellery featuring the brilliance
                of diamonds, sapphires, rubies and emeralds.
            </p>

        </div>

        <div class="stone-grid">

            <article class="stone-card reveal">

                <a href="#"
                   aria-label="Explore Diamond Jewellery">

                    <div class="stone-image">

                        <img src="~/assets/images/home/stones/diamond-jewellery.jpg"
                             alt="Diamond Jewellery"
                             loading="lazy" />

                        <div class="stone-overlay"></div>

                        <div class="stone-content">

                            <p>Brilliant and timeless</p>

                            <h3>Diamond Jewellery</h3>

                            <span>
                                Explore Collection
                                <i class="bi bi-arrow-right"></i>
                            </span>

                        </div>

                    </div>

                </a>

            </article>

            <article class="stone-card reveal">

                <a href="#"
                   aria-label="Explore Sapphire Jewellery">

                    <div class="stone-image">

                        <img src="~/assets/images/home/stones/sapphire-jewellery.jpg"
                             alt="Sapphire Jewellery"
                             loading="lazy" />

                        <div class="stone-overlay"></div>

                        <div class="stone-content">

                            <p>Deep and majestic</p>

                            <h3>Sapphire Jewellery</h3>

                            <span>
                                Explore Collection
                                <i class="bi bi-arrow-right"></i>
                            </span>

                        </div>

                    </div>

                </a>

            </article>

            <article class="stone-card reveal">

                <a href="#"
                   aria-label="Explore Ruby Jewellery">

                    <div class="stone-image">

                        <img src="~/assets/images/home/stones/ruby-jewellery.jpg"
                             alt="Ruby Jewellery"
                             loading="lazy" />

                        <div class="stone-overlay"></div>

                        <div class="stone-content">

                            <p>Passionate and refined</p>

                            <h3>Ruby Jewellery</h3>

                            <span>
                                Explore Collection
                                <i class="bi bi-arrow-right"></i>
                            </span>

                        </div>

                    </div>

                </a>

            </article>

            <article class="stone-card reveal">

                <a href="#"
                   aria-label="Explore Emerald Jewellery">

                    <div class="stone-image">

                        <img src="~/assets/images/home/stones/emerald-jewellery.jpg"
                             alt="Emerald Jewellery"
                             loading="lazy" />

                        <div class="stone-overlay"></div>

                        <div class="stone-content">

                            <p>Vivid and extraordinary</p>

                            <h3>Emerald Jewellery</h3>

                            <span>
                                Explore Collection
                                <i class="bi bi-arrow-right"></i>
                            </span>

                        </div>

                    </div>

                </a>

            </article>

        </div>

    </div>

</section>

<!-- WOMEN AND MEN -->
<section class="gateway-section"
         aria-label="Shop women and men">

    <article class="gateway-card reveal"
             id="women">

        <img src="~/assets/images/home/category-women.jpg"
             alt="Handmade jewellery for women"
             loading="lazy" />

        <div class="gateway-overlay"></div>

        <div class="gateway-content">

            <p>Explore</p>

            <h2>Women</h2>

            <a asp-controller="Women"
                asp-action="Index"
                class="text-link text-link-light">

                Shop Women
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </article>

    <article class="gateway-card reveal"
             id="men">

        <img src="~/assets/images/home/category-men.jpg"
             alt="Handmade jewellery for men"
             loading="lazy" />

        <div class="gateway-overlay"></div>

        <div class="gateway-content">

            <p>Explore</p>

            <h2>Men</h2>

            <a href="#"
               class="text-link text-link-light">

                Shop Men
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </article>

</section>

