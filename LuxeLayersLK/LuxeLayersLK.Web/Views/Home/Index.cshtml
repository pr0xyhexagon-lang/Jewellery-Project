<!-- CUSTOMIZATION -->
<section class="split-feature"
         id="customization">

    <div class="split-feature-image reveal">

        <img src="~/assets/images/home/customization.jpg"
             alt="Customized handmade jewellery"
             loading="lazy" />

    </div>

    <div class="split-feature-content reveal">

        <p class="section-eyebrow">
            Made Especially for You
        </p>

        <h2>
            Create jewellery that tells your story
        </h2>

        <p>
            Personalize a meaningful piece with your preferred design,
            finish, size, name, initials or engraving.
            Share your idea and our team will guide you through
            the customization process.
        </p>

        <ul class="customization-list">

            <li>
                <i class="bi bi-check2"></i>
                Names, initials and meaningful symbols
            </li>

            <li>
                <i class="bi bi-check2"></i>
                Silver, gold-plated and rose-gold-plated finishes
            </li>

            <li>
                <i class="bi bi-check2"></i>
                Custom sizing and personal engraving
            </li>

            <li>
                <i class="bi bi-check2"></i>
                Upload your reference design
            </li>

        </ul>

        <a href="#"
           class="luxury-button luxury-button-dark">

            Start Your Custom Order

        </a>

    </div>

</section>


<!-- BRAND STORY -->
<section class="story-section section-padding"
         id="about">

    <div class="luxury-container story-grid">

        <div class="story-content reveal">

            <p class="section-eyebrow">
                Our Story
            </p>

            <h2>
                Handmade with intention
            </h2>

            <p>
                Luxe Layers LK was created with a love for jewellery
                that feels personal, expressive and timeless.
                Every piece is handmade with care and designed
                to become part of your individual story.
            </p>

            <p>
                From delicate everyday pieces to meaningful customized
                designs, we believe jewellery should celebrate every
                layer of who you are.
            </p>

            <a href="#"
               class="text-link">

                Discover Our Story
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

        <div class="story-image reveal">

            <img src="~/assets/images/home/brand-story.jpg"
                 alt="Luxe Layers LK handmade jewellery craftsmanship"
                 loading="lazy" />

            <div class="story-note">
                <span>Every piece</span>
                <strong>Handmade</strong>
                <span>with care</span>
            </div>

        </div>

    </div>

</section>


<!-- BENEFITS -->
<section class="benefits-section">

    <div class="luxury-container benefits-grid">

        <article class="benefit-item reveal">

            <i class="bi bi-gem"></i>

            <div>
                <h3>Handmade Jewellery</h3>
                <p>Carefully made with attention to every detail.</p>
            </div>

        </article>

        <article class="benefit-item reveal">

            <i class="bi bi-stars"></i>

            <div>
                <h3>Premium Finishes</h3>
                <p>Silver, gold-plated and rose-gold-plated designs.</p>
            </div>

        </article>

        <article class="benefit-item reveal">

            <i class="bi bi-box-seam"></i>

            <div>
                <h3>Islandwide Delivery</h3>
                <p>Secure delivery throughout Sri Lanka.</p>
            </div>

        </article>

        <article class="benefit-item reveal">

            <i class="bi bi-pencil-square"></i>

            <div>
                <h3>Personalized for You</h3>
                <p>Custom designs created around your story.</p>
            </div>

        </article>

    </div>

</section>


<!-- GALLERY -->
