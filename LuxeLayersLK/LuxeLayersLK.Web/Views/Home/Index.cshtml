</section>

<!-- NEWSLETTER -->
<section class="newsletter-section">

    <div class="luxury-container newsletter-inner reveal">

        <div>

            <p class="section-eyebrow">
                Join the Luxe List
            </p>

            <h2>
                Be the first to discover what’s new
            </h2>

            <p>
                Receive new-arrival updates, exclusive offers
                and jewellery inspiration.
            </p>

        </div>

        <form class="newsletter-form"
              id="newsletterForm">

            <label class="visually-hidden"
                   for="newsletterEmail">
                Email address
            </label>

            <input id="newsletterEmail"
                   type="email"
                   placeholder="Enter your email address"
                   required />

            <button type="submit">
                Subscribe
                <i class="bi bi-arrow-right"></i>
            </button>

            <p class="newsletter-message"
               id="newsletterMessage"
               aria-live="polite">
